# ==============================================================================
# GrowX AI Gateway — Canonical Environment Configuration (.env.example)
# Note: Never commit actual secrets or production keys to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Core Runtime & Security
# ------------------------------------------------------------------------------
NODE_ENV=development                       # Options: development, test, production
LOG_LEVEL=info                            # Options: debug, info, warn, error
PUBLIC_APP_URL=https://app.growxlabs.tech # Production canonical console origin (HTTPS required in prod)
SERVICE_AUTH_SECRET=                      # Min 32-character high-entropy secret for inter-service JWTs
API_KEY_PEPPER=                           # Min 32-character high-entropy secret for hashing customer API keys
PROVIDER_ENCRYPTION_KEY=                  # 32-byte (64 hex characters) AES-256-GCM master key for Provider Vault
TRUST_PROXY_TLS=false                     # Set to true behind reverse proxy / load balancer
CORS_ALLOWED_ORIGINS=https://app.growxlabs.tech,https://admin.growxlabs.tech,https://growxlabs.tech

# ------------------------------------------------------------------------------
# 2. Database (PostgreSQL)
# ------------------------------------------------------------------------------
# PostgreSQL connection string (must use TLS and dedicated pooled role in production)
DATABASE_URL=postgresql://growx_app:your_production_password@db.growxlabs.tech:5432/growx_production?sslmode=require

# ------------------------------------------------------------------------------
# 3. Redis (Cache, Rate Limiting, Leases)
# ------------------------------------------------------------------------------
# Redis connection string (rediss:// for TLS in production)
REDIS_URL=rediss://default:your_redis_password@redis.growxlabs.tech:6379

# ------------------------------------------------------------------------------
# 4. Authentication (Better Auth & Identity Service)
# ------------------------------------------------------------------------------
BETTER_AUTH_SECRET=                       # Min 32-character high-entropy session signing secret
BETTER_AUTH_URL=https://auth.growxlabs.tech # Identity service root URL
IDENTITY_SERVICE_URL=http://identity-service:4000
GOOGLE_CLIENT_ID=                         # Optional: Google OAuth 2.0 Client ID
GOOGLE_CLIENT_SECRET=                     # Optional: Google OAuth 2.0 Client Secret
GITHUB_CLIENT_ID=                         # Optional: GitHub OAuth App Client ID
GITHUB_CLIENT_SECRET=                     # Optional: GitHub OAuth App Client Secret

# ------------------------------------------------------------------------------
# 5. Email Delivery (Resend)
# ------------------------------------------------------------------------------
RESEND_API_KEY=                           # Resend API Key (re_...) for OTP and notifications
RESEND_FROM_EMAIL=auth@growxlabs.tech     # Verified domain sender email address
RESEND_REPLY_TO=support@growxlabs.tech    # Reply-to address for customer correspondence
NOTIFICATION_SERVICE_URL=http://notification-service:4013

# ------------------------------------------------------------------------------
# 6. Payment Gateways (Razorpay & Stripe)
# ------------------------------------------------------------------------------
RAZORPAY_KEY_ID=                          # Razorpay Key ID (rzp_live_... or rzp_test_...)
RAZORPAY_KEY_SECRET=                      # Razorpay Key Secret
RAZORPAY_WEBHOOK_SECRET=                  # Secret for verifying Razorpay HMAC signatures
STRIPE_SECRET_KEY=                        # Optional: Stripe Secret Key (sk_live_... or sk_test_...)
STRIPE_WEBHOOK_SECRET=                    # Optional: Stripe Webhook Signing Secret (whsec_...)

# ------------------------------------------------------------------------------
# 7. Object Storage (Cloudflare R2 / AWS S3 Compatible)
# ------------------------------------------------------------------------------
R2_ACCOUNT_ID=                            # Cloudflare Account ID
R2_ACCESS_KEY_ID=                         # R2 / S3 Access Key ID
R2_SECRET_ACCESS_KEY=                     # R2 / S3 Secret Access Key
R2_BUCKET=growx-production-files          # Bucket name for invoices, file objects, batches

# ------------------------------------------------------------------------------
# 8. AI Provider Credentials (Bootstrap / Direct Adapters)
# ------------------------------------------------------------------------------
# Note: Production providers should ideally be provisioned via Provider Vault (Phase 28)
OPENAI_API_KEY=                           # OpenAI upstream API Key
ANTHROPIC_API_KEY=                        # Anthropic upstream API Key
GOOGLE_GENERATIVE_AI_API_KEY=             # Google Gemini API Key
GROQ_API_KEY=                             # Groq Cloud API Key
MISTRAL_API_KEY=                          # Mistral AI API Key
TOGETHER_API_KEY=                         # Together AI API Key
FIREWORKS_API_KEY=                        # Fireworks AI API Key
CEREBRAS_API_KEY=                         # Cerebras API Key

# ------------------------------------------------------------------------------
# 9. Observability & Telemetry
# ------------------------------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=https://otel.growxlabs.tech # OpenTelemetry OTLP collector
SENTRY_DSN=                               # Optional: Sentry DSN for error monitoring
AXIOM_TOKEN=                              # Optional: Axiom token for streaming structured logs
CLICKHOUSE_URL=                           # Optional: ClickHouse analytics cluster URL
